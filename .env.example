# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Product Service DB
PRODUCT_DB_URL=postgresql://postgres:postgres@product-db:5432/products

# Order Service DB
ORDER_DB_URL=postgresql://postgres:postgres@order-db:5432/orders

# Inventory Service DB
INVENTORY_DB_URL=postgresql://postgres:postgres@inventory-db:5432/inventory

# Payment Service DB
PAYMENT_DB_URL=postgresql://postgres:postgres@payment-db:5432/payments

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672

# Redis
REDIS_URL=redis://redis:6379

# JWT Secret
JWT_SECRET=change-me-in-production

# Service Ports
API_GATEWAY_PORT=3000
PRODUCT_SERVICE_PORT=3001
ORDER_SERVICE_PORT=3002
INVENTORY_SERVICE_PORT=3003
PAYMENT_SERVICE_PORT=3004
NOTIFICATION_SERVICE_PORT=3005
FRONTEND_PORT=4000
